# Backend API URL (Empty string in production on Vercel so relative /api routing is used)
REACT_APP_BACKEND_URL=http://localhost:8000

# Supabase Auth Configuration (from your Supabase Dashboard -> Project Settings -> API)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here
